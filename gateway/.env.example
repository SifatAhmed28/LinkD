# Gateway Environment Variables
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SAFE=86400        # 24 hours in seconds
REDIS_TTL_MALICIOUS=259200  # 72 hours in seconds

# ML Service (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000

# GitHub API (Optional — raises limit from 60 to 5000 req/hour)
GITHUB_TOKEN=your_github_personal_access_token_here

# Level 2 Score Thresholds
SCORE_SAFE_THRESHOLD=0.2
SCORE_MALICIOUS_THRESHOLD=0.85

# Content hash fetch timeout (ms)
CONTENT_HASH_TIMEOUT=5000
