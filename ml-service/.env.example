# ML Service Environment Variables
PORT=8000

# Model loading strategy: "lazy" (load on first request) or "eager" (load at startup)
MODEL_LOAD_STRATEGY=lazy

# Screenshot storage
SCREENSHOT_DIR=./screenshots

# Visual similarity threshold (cosine similarity)
VISUAL_SIMILARITY_THRESHOLD=0.82

# Sentiment fear threshold
FEAR_SCORE_THRESHOLD=0.6

# Playwright settings
PLAYWRIGHT_TIMEOUT=15000
PLAYWRIGHT_HEADLESS=true

# Score fusion weights (must sum to 1.0)
WEIGHT_FEAR=0.25
WEIGHT_FORM=0.30
WEIGHT_OCR=0.20
WEIGHT_VISUAL=0.25

# Final verdict thresholds
VERDICT_SAFE_THRESHOLD=0.3
VERDICT_MALICIOUS_THRESHOLD=0.7
